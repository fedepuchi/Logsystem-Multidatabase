# Copiar como .env antes de `docker compose up`.
#
# Ojo: docker compose NO interpola variables dentro de un env_file. Cada valor
# tiene que estar escrito completo; no usar ${OTRA_VARIABLE} acá.

# --- aplicación --------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info

# Un único worker: los locks por fuente y el mapa de destinos activos del
# router viven en memoria del proceso. Con más de un worker se rompe la
# exclusión que garantiza el switch sin pérdida.
WEB_CONCURRENCY=1

# Metadata (conexiones, fuentes, historial de bindings y auditoría).
# Dentro del contenedor apunta al volumen meta_data.
SQLITE_PATH=/app/data/logmon.db

# Build del SPA servido por FastAPI. Vacío = se autodetecta.
STATIC_DIR=/app/frontend/dist

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- autenticación -----------------------------------------------------
# Clave de la superficie de ADMINISTRACIÓN (conexiones, fuentes, switch,
# visor). Viaja en el header X-Admin-Key y la usa el panel.
#
# La INGESTA no usa esta clave: cada fuente tiene sus propias API keys, que se
# emiten desde el panel o con
#   POST /api/sources/{fuente}/keys
# y viajan en el header X-API-Key. Una key sólo escribe logs de su fuente.
#
# Vacía = API abierta, sin autenticación en ninguna de las dos superficies. Es
# el modo de la demo local; con APP_ENV distinto de development el backend se
# niega a arrancar así.
ADMIN_API_KEY=

# --- C1: MariaDB -------------------------------------------------------
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=logdb
MARIADB_USER=loguser
MARIADB_PASSWORD=logpass
MARIADB_ROOT_PASSWORD=root123

# --- C2: PostgreSQL ----------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=logdb
POSTGRES_USER=loguser
POSTGRES_PASSWORD=logpass

# --- C3: SQL Server ----------------------------------------------------
# La password de SA debe cumplir la política de complejidad (mayúscula,
# minúscula, dígito y símbolo, 8+ caracteres) o el contenedor arranca y muere
# sin mensaje claro. La base logdb no la crea la imagen: la crea el adapter.
SQLSERVER_HOST=sqlserver
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
MSSQL_SA_PASSWORD=Alec2026!SecureSQL
SQLSERVER_DATABASE=logdb
ACCEPT_EULA=1

# --- C4: MongoDB -------------------------------------------------------
# El contenedor de la demo corre sin autenticación: dejar usuario y password
# vacíos hace que el adapter arme la URI sin credenciales.
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=logdb
MONGO_USER=
MONGO_PASSWORD=

# --- C5: Redis ---------------------------------------------------------
# Sin requirepass en la demo. REDIS_DB es el número de base (0-15).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=
REDIS_PASSWORD=
